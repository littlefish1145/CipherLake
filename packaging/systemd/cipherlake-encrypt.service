[Unit]
Description=CipherLake Encrypt Microservice
After=network-online.target
Wants=network-online.target
PartOf=cipherlake.target

[Service]
Type=simple
User=cipherlake
Group=cipherlake
ExecStart=/usr/local/bin/encrypt-service --address :50051
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=cipherlake.target
