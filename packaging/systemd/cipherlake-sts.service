[Unit]
Description=CipherLake STS Microservice
After=network-online.target
Wants=network-online.target
PartOf=cipherlake.target

[Service]
Type=simple
User=cipherlake
Group=cipherlake
ExecStart=/usr/local/bin/sts-service --address :50057
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=cipherlake.target
