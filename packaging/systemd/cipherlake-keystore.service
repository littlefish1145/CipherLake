[Unit]
Description=CipherLake KeyStore Microservice
After=network-online.target
Wants=network-online.target
PartOf=cipherlake.target

[Service]
Type=simple
User=cipherlake
Group=cipherlake
ExecStart=/usr/local/bin/keystore-service --address :50054
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cipherlake

[Install]
WantedBy=cipherlake.target
